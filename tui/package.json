    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "chalk": "^5.4.0",
    "cli-highlight": "^2.1.11",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
